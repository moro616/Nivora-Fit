# ============================================================
# Copiá este archivo como .env y completá con tus valores.
# En producción, estas mismas variables se cargan en:
# Netlify → Site settings → Environment variables
# ============================================================

# --- Identidad de la app ---
APP_NOMBRE="Nivora Fit"
URL_APP="https://nivorafit.netlify.app"  # la raíz del sitio, sin /app

# --- Supabase (Project Settings → API) ---
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhb..."
# La service_role saltea TODAS las reglas de seguridad.
# Va solo acá, nunca en el navegador ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY="eyJhb..."

# --- Mercado Pago (Tus integraciones → Credenciales de producción) ---
MP_ACCESS_TOKEN="APP_USR-..."
# Lo generás al crear el webhook en el panel de Mercado Pago.
MP_WEBHOOK_SECRET=""

# --- Precio ---
PRECIO_MENSUAL=10000
MONEDA="ARS"
DIAS_PRUEBA=7

# --- Entrenador de IA (n8n) ---
N8N_WEBHOOK_URL="https://tu-n8n.com/webhook/entrenador"
N8N_WEBHOOK_TOKEN="inventa-una-clave-larga-y-random"
CHAT_LIMITE_DIARIO=40
